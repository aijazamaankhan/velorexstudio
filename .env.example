# Copy to .env.local and fill in. Never commit .env.local.

# Public site URL — used for canonical links, sitemap and share cards.
# Owned production domain. Set this before the hosting build.
# NEVER put a secret in a variable that starts with NEXT_PUBLIC_ — those are
# sent to every visitor's browser.
NEXT_PUBLIC_SITE_URL=https://velorexstudio.com

# ── Contact form delivery ─────────────────────────────────────
# Set ONE of the two options below. With neither set, the form
# honestly reports that it cannot send and offers email instead.

# These are secrets: keep them in .env.local or the host's settings only.

# Option A: any https:// endpoint that accepts a JSON POST
# (Slack/Discord webhook, Zapier, Make, Google Apps Script, your own API…)
CONTACT_WEBHOOK_URL=

# Option B: Resend (https://resend.com)
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
